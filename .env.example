# Copie este arquivo para .env e preencha com sua própria chave do Google AI Studio.
# Nunca versione o .env nem valores reais. Este arquivo contém apenas nomes de variáveis.

# Chave do Google AI Studio (https://aistudio.google.com/apikey).
# Verificado em google.genai._api_client (2026-10-18): a biblioteca lê GOOGLE_API_KEY
# primeiro e, se ausente, GEMINI_API_KEY. Use GOOGLE_API_KEY.
GOOGLE_API_KEY=

# Deve ficar vazia ou ausente para usar o Google AI Studio diretamente
# (em vez do Vertex AI). Não definir como "True" neste projeto.
GOOGLE_GENAI_USE_VERTEXAI=
